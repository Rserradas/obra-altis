rules_version = '2';
// Regras de acesso à base de dados da obra.
// Dono de obra e administrador: tudo. Empreiteiro: execução, previsões e ligações. Fiscal: vistorias. Todos: ver e juntar fotografias.
// Repor cópias de segurança: todas as pessoas com acesso podem (decisão do dono de obra), por isso todas podem escrever em tudo menos nos acessos.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function perfil() { return get(/databases/$(database)/documents/utilizadores/$(email())).data; }
    function temPerfil() { return request.auth != null && exists(/databases/$(database)/documents/utilizadores/$(email())); }
    function isDono() { return request.auth != null && (email() == "rodrigo.serradas@haegergroup.com" || (temPerfil() && perfil().papel in ["dono", "admin"])); }
    function membro() { return isDono() || temPerfil(); }
    function papel() { return temPerfil() ? perfil().papel : ""; }
    function soMuda(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    match /utilizadores/{e} {
      allow read: if membro();
      allow write: if isDono();
    }
    match /config/{d} {
      allow read: if membro();
      allow write: if isDono();
      // o empreiteiro gere as equipas e as especialidades (sequência, ordem, nomes, dias por fração)
      allow update: if papel() == "empreiteiro" && soMuda(["equipas", "regras", "especialidades", "duracoes"]);
      allow write: if membro(); // repor uma cópia de segurança
    }
    match /atividades/{id} {
      allow read: if membro();
      allow create: if isDono() || papel() == "empreiteiro";
      allow delete: if isDono();
      allow update: if isDono()
        || (papel() == "empreiteiro" && soMuda(["realInicio", "realFim", "concluido", "pctEmp", "empEm", "inicioPrevisto", "fimPrevisto",
              "motivo", "duracaoManual", "equipa", "eqOrdem", "unidade", "depsExtra", "depsIgnorar", "dataOk", "atualizadoEm", "atualizadoPor"]))
        || (papel() == "fiscal" && soMuda(["pctFiscal", "fiscalEm", "fiscalPor", "fiscalNota", "fiscalNotaEm", "atualizadoEm", "atualizadoPor"]));
      allow write: if membro(); // repor uma cópia de segurança
    }
    match /fotos/{id} {
      allow read: if membro();
      allow create: if membro() && request.resource.data.por == email();
      allow delete: if isDono() || (membro() && resource.data.por == email());
      allow write: if membro(); // repor uma cópia de segurança
    }
    // Pendentes: todos criam. O dono e o fiscal fecham qualquer um; só o fiscal dá o ok de fiscal.
    // O empreiteiro marca como feito e só fecha os que ele próprio criou.
    match /pendentes/{id} {
      allow read: if membro();
      allow create: if isDono() || (membro() && request.resource.data.criadoPor == email());
      allow update: if isDono() || papel() == "fiscal"
        || (membro()
            && request.resource.data.get("fiscalOk", false) == resource.data.get("fiscalOk", false)
            && request.resource.data.criadoPor == resource.data.criadoPor
            && request.resource.data.criadoPapel == resource.data.criadoPapel
            && (request.resource.data.estado != "fechado" || resource.data.estado == "fechado" || resource.data.criadoPapel == papel()));
      allow delete: if isDono() || (membro() && resource.data.criadoPor == email());
      allow write: if membro(); // repor uma cópia de segurança
    }
    match /registos/{id} {
      allow read: if membro();
      allow create: if membro() && request.resource.data.por == email();
      allow write: if membro(); // repor uma cópia de segurança
    }
  }
}
